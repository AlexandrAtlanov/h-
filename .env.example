# Скопируйте в .env и заполните. .env в git НЕ коммитится.
# Любой OpenAI-совместимый API: /chat/completions, /embeddings, /rerank по одному адресу.
LLM_BASE_URL=https://your-proxy.example/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Эмбеддинги и реранкер (по умолчанию тот же адрес и ключ, что у LLM)
EMB_MODEL=baai/bge-m3
# EMB_BASE_URL=
# EMB_API_KEY=
RERANKER_MODEL=
RERANKER_TOP_N=8
# RERANKER_BASE_URL=
# RERANKER_API_KEY=

# Прогон
DATA_DIR=data
MAX_WORKERS=6
TOP_K=6
TEMPERATURE=0
# TRACE_FILE=trace.jsonl
